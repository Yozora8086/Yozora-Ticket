<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.lcy.yozoraticket.mapper.TicketsMapper">

    <insert id="insertTicket">
        insert into tickets (order_item_id,ticket_code,status,created_time)
        values
        (#{orderItemId},#{ticketCode},#{status},#{createdTime})
    </insert>


    <update id="updateStatus">
        UPDATE tickets SET status = 1,verified_time = now() WHERE ticket_code = #{ticketCode}
    </update>

    <update id="updateTimeOutStatus">
        UPDATE tickets SET status = 2
           WHERE ticket_id IN
           <foreach collection="tickets"
                    item="ticket"
                    open="("
                    separator=","
                    close=")">
           #{ticket.ticketId}
           </foreach>
           AND status = 0
    </update>

    <select id="selectTimeOutTicket" resultType="com.lcy.yozoraticket.entity.Ticket">
        select t.* from tickets t
          join order_items oi
          on t.order_item_id = oi.order_item_id
          where oi.session_time &lt; now() + interval 15 minute
          and t.status != 1
    </select>
</mapper>