<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.lcy.yozoraticket.mapper.OrderMapper">

    <insert id="insert" useGeneratedKeys="true" keyColumn="order_id" keyProperty="orderId">
        insert into orders (event_session_id,order_no,user_id,ticket_level,total,ticket_total,status,pay_close_time)
            values
        (#{eventSessionId},#{orderNo},#{userId},#{ticketLevel},#{total},#{ticketTotal},#{status},#{payCloseTime})
    </insert>

</mapper>