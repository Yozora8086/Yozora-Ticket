<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.lcy.yozoraticket.mapper.VenueMapper">

    <insert id="addVenue" useGeneratedKeys="true" keyColumn="venue_id" keyProperty="venueId">
        INSERT INTO venues (venue_name,venue_city,venue_address)
        VALUES
            (#{venueName},#{venueCity},#{venueAddress})
    </insert>
</mapper>